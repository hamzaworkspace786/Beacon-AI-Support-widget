# Copy this file to .env.local and fill it in. Never commit .env.local.
# On Vercel, add the same names under Project > Settings > Environment Variables.

# MongoDB Atlas connection string. You can reuse the DocLens one: the app creates
# its own database called "beacon", so the two projects never mix.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=beacon

# Generate a NEW value for this app:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Where the app runs: http://localhost:3000 locally, your real address on Vercel.
BETTER_AUTH_URL=http://localhost:3000

# Optional Google sign-in. You can reuse the DocLens client ID and secret locally,
# because both apps use the same redirect address on localhost:3000
# (<BETTER_AUTH_URL>/api/auth/callback/google). Add the new Vercel address later.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Free key from Google AI Studio: https://aistudio.google.com/apikey
# Not used in Phase 1. Needed from Phase 2 (embeddings) and Phase 3 (answers).
GOOGLE_GENERATIVE_AI_API_KEY=
